<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TaskManager"
        xmlns:vm="using:TaskManager.ViewModels"
        xmlns:loc="using:TaskManager.Services"
        x:CompileBindings="False"
        x:DataType="local:MainWindow"
        x:Class="TaskManager.MainWindow"
        Width="1120" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Title="TaskManager"
        Icon="avares://TaskManager/Assets/app-icon.png">
    <Window.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style Selector="Border.task-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="26">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,22">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock FontSize="42" FontWeight="Bold" LetterSpacing="-0.5">
                    <Run Text="Task" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <Run Text="Manager" Foreground="{DynamicResource AccentBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding [app.subtitle], Source={x:Static loc:Loc.Instance}}"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Orientation="Horizontal" ItemSpacing="8">
                <Button Classes="secondary" ToolTip.Tip="{Binding [lang.tooltip], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [lang.tooltip], Source={x:Static loc:Loc.Instance}}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{Binding [lang.name.ru], Source={x:Static loc:Loc.Instance}}"
                                      ToggleType="CheckBox" IsChecked="{Binding IsRussian, Source={x:Static loc:Loc.Instance}, Mode=OneWay}"
                                      Click="LanguageRussianClick" />
                            <MenuItem Header="{Binding [lang.name.en], Source={x:Static loc:Loc.Instance}}"
                                      ToggleType="CheckBox" IsChecked="{Binding IsEnglish, Source={x:Static loc:Loc.Instance}, Mode=OneWay}"
                                      Click="LanguageEnglishClick" />
                            <MenuItem Header="{Binding [lang.name.kk], Source={x:Static loc:Loc.Instance}}"
                                      ToggleType="CheckBox" IsChecked="{Binding IsKazakh, Source={x:Static loc:Loc.Instance}, Mode=OneWay}"
                                      Click="LanguageKazakhClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Classes="icon" Data="M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 Z M2,12 H22 M12,2 A15.3,15.3 0 0 1 16,12 A15.3,15.3 0 0 1 12,22 A15.3,15.3 0 0 1 8,12 A15.3,15.3 0 0 1 12,2 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding LanguageButtonText}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="secondary" ToolTip.Tip="{Binding ThemeTooltip}" Click="ThemeClick" Padding="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Panel Width="18" Height="18" VerticalAlignment="Center">
                            <!-- Системная тема: значок монитора -->
                            <Viewbox IsVisible="{Binding IsSystemTheme}">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="icon" Data="M4,3 H20 A2,2 0 0 1 22,5 V15 A2,2 0 0 1 20,17 H4 A2,2 0 0 1 2,15 V5 A2,2 0 0 1 4,3 Z M8,21 H16 M12,17 V21" />
                                </Canvas>
                            </Viewbox>
                            <!-- Светлая тема: солнце -->
                            <Viewbox IsVisible="{Binding IsLightTheme}">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="icon" Data="M17,12 A5,5 0 1 1 7,12 A5,5 0 1 1 17,12 Z M12,1 V3 M12,21 V23 M4.22,4.22 L5.64,5.64 M18.36,18.36 L19.78,19.78 M1,12 H3 M21,12 H23 M4.22,19.78 L5.64,18.36 M18.36,5.64 L19.78,4.22" />
                                </Canvas>
                            </Viewbox>
                            <!-- Тёмная тема: луна -->
                            <Viewbox IsVisible="{Binding IsDarkTheme}">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="icon" Data="M21,12.79 A9,9 0 1 1 11.21,3 A7,7 0 0 0 21,12.79 Z" />
                                </Canvas>
                            </Viewbox>
                        </Panel>
                        <TextBlock Text="{Binding ThemeLabel}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Content="{Binding BinButtonText}" ToolTip.Tip="{Binding [main.binTooltip], Source={x:Static loc:Loc.Instance}}"
                        Click="OpenBinClick" />
                <Button Classes="secondary" Content="{Binding [main.calendar], Source={x:Static loc:Loc.Instance}}"
                        ToolTip.Tip="{Binding [main.calendarTooltip], Source={x:Static loc:Loc.Instance}}" Click="OpenCalendarClick" />
                <Button Classes="secondary" Content="{Binding [main.analytics], Source={x:Static loc:Loc.Instance}}"
                        ToolTip.Tip="{Binding [main.analyticsTooltip], Source={x:Static loc:Loc.Instance}}" Click="OpenAnalyticsClick" />
                <Button Content="{Binding [main.addTask], Source={x:Static loc:Loc.Instance}}" Classes="accent" Click="AddTaskClick" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Classes="surface" Padding="0" Margin="0,0,0,18">
            <Grid ColumnDefinitions="*,*,*">
                <StackPanel Margin="17,13" Spacing="4">
                    <TextBlock Text="{Binding [stats.total], Source={x:Static loc:Loc.Instance}}" Classes="section-label" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="25" FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0">
                    <StackPanel Margin="17,13" Spacing="4">
                        <TextBlock Text="{Binding [stats.done], Source={x:Static loc:Loc.Instance}}" Classes="section-label" />
                        <TextBlock Text="{Binding DoneCount}" FontSize="25" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Margin="17,13" Spacing="4">
                    <TextBlock Text="{Binding [stats.overdue], Source={x:Static loc:Loc.Instance}}" Classes="section-label" />
                    <TextBlock Text="{Binding OverdueCount}" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="surface" Padding="9" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="8">
                <TextBox x:Name="SearchBox" PlaceholderText="{Binding [filter.search], Source={x:Static loc:Loc.Instance}}" TextChanged="FilterChanged"
                         Width="260" MinWidth="180" />
                <ComboBox x:Name="StateFilter" Width="170" SelectionChanged="FilterChanged" />
                <ComboBox x:Name="PriorityFilter" Width="180" SelectionChanged="FilterChanged" />
                <Button Classes="secondary" Content="{Binding [filter.reset], Source={x:Static loc:Loc.Instance}}"
                        ToolTip.Tip="{Binding [filter.resetTooltip], Source={x:Static loc:Loc.Instance}}"
                        Click="ResetFiltersClick" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskCardViewModel">
                            <Border Classes="task-card">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="14">
                                    <Border Background="{Binding PriorityBrush}" CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Spacing="9" MinWidth="0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <Border Grid.Column="1" Background="{DynamicResource DangerSurfaceBrush}"
                                                    CornerRadius="6" Padding="8,4" IsVisible="{Binding IsOverdue}">
                                                <TextBlock Text="{Binding [card.overdueBadge], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource DangerBrush}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}" Classes="secondary" FontSize="13"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="18" LineSpacing="6">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding [card.dueLabel], Source={x:Static loc:Loc.Instance}}" Classes="section-label" />
                                                <TextBlock Text="{Binding DueDateText}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding [card.remainingLabel], Source={x:Static loc:Loc.Instance}}" Classes="section-label" />
                                                <TextBlock Text="{Binding RemainingText}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="6">
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="8,4">
                                                <TextBlock Text="{Binding PriorityText}" FontSize="11" />
                                            </Border>
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="8,4">
                                                <TextBlock Text="{Binding TypeText}" FontSize="11" />
                                            </Border>
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="8,4"
                                                    IsVisible="{Binding HasDetails}">
                                                <TextBlock Text="{Binding DetailsText}" FontSize="11" TextWrapping="Wrap" />
                                            </Border>
                                            <Border Background="{DynamicResource HoverBrush}" CornerRadius="5" Padding="8,4">
                                                <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="action secondary" Content="{Binding [card.edit], Source={x:Static loc:Loc.Instance}}"
                                                ToolTip.Tip="{Binding [card.editTooltip], Source={x:Static loc:Loc.Instance}}"
                                                Tag="{Binding}" Click="EditTaskClick" />
                                        <Button Classes="action danger" Content="{Binding [card.delete], Source={x:Static loc:Loc.Instance}}"
                                                ToolTip.Tip="{Binding [card.deleteTooltip], Source={x:Static loc:Loc.Instance}}"
                                                Tag="{Binding}" Click="DeleteTaskClick" />
                                        <Button Classes="action accent" Content="{Binding [card.done], Source={x:Static loc:Loc.Instance}}"
                                                ToolTip.Tip="{Binding [card.doneTooltip], Source={x:Static loc:Loc.Instance}}"
                                                Tag="{Binding}" IsVisible="{Binding CanMarkDone}" Click="MarkDoneClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Classes="surface" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                    MaxWidth="440" IsVisible="{Binding IsEmptyStateVisible}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyMessage}" Classes="secondary" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Padding="14,10"
                    CornerRadius="10" Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    IsVisible="{Binding IsToastVisible}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinWidth="260">
                    <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="secondary" Content="×" Padding="7,2" MinHeight="28"
                            Click="CloseToastClick" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
