<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskManager.Dialogs.TaskEditWindow"
        Width="520"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Title="Задача">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12">
            <TextBlock x:Name="HeaderText" FontSize="24" FontWeight="SemiBold"/>

            <TextBlock Text="Название"/>
            <TextBox x:Name="TitleBox" MaxLength="100"/>
            <TextBlock x:Name="TitleError" Classes="error"/>

            <TextBlock Text="Описание"/>
            <TextBox x:Name="DescriptionBox" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Срок выполнения"/>
            <DatePicker x:Name="DueDatePicker"/>
            <TextBlock x:Name="DueDateError" Classes="error"/>

            <TextBlock Text="Время выполнения"/>
            <TimePicker x:Name="DueTimePicker" ClockIdentifier="24HourClock"/>
            <TextBlock x:Name="DueTimeError" Classes="error"/>

            <TextBlock Text="Приоритет"/>
            <ComboBox x:Name="PriorityBox"/>

            <TextBlock Text="Статус"/>
            <ComboBox x:Name="StateBox"/>

            <TextBlock Text="Вид задачи"/>
            <ComboBox x:Name="TypeBox"/>

            <StackPanel x:Name="RecurringPanel" Spacing="6" IsVisible="False">
                <TextBlock Text="Повторять каждые N дней"/>
                <NumericUpDown x:Name="RepeatBox" Minimum="1" Maximum="365" Increment="1"/>
                <TextBlock x:Name="RepeatError" Classes="error"/>
            </StackPanel>

            <StackPanel x:Name="ProjectPanel" Spacing="6" IsVisible="False">
                <TextBlock Text="Название проекта"/>
                <TextBox x:Name="ProjectBox"/>
                <TextBlock x:Name="ProjectError" Classes="error"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
                <Button Content="Отмена" Click="CancelClick"/>
                <Button Content="Сохранить" Classes="accent" Click="SaveClick"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
