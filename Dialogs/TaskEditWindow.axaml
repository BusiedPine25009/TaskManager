<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskManager.Dialogs.TaskEditWindow"
        Width="560" Height="720" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner" Title="Задача"
        Icon="avares://TaskManager/Assets/app-icon.png">
    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,26,26,18" Spacing="12">
            <TextBlock x:Name="HeaderText" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Заполните детали и срок выполнения" Classes="secondary" Margin="0,0,0,6" />

            <Border Classes="surface" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="ОСНОВНОЕ" Classes="section-label" />
                    <TextBlock Text="Название" FontWeight="SemiBold" />
                    <TextBox x:Name="TitleBox" MaxLength="100" />
                    <TextBlock x:Name="TitleError" Classes="error" />
                    <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBox x:Name="DescriptionBox" MinHeight="82" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Border>

            <Border Classes="surface" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="СРОК И СОСТОЯНИЕ" Classes="section-label" />
                    <TextBlock Text="Дата выполнения" FontWeight="SemiBold" />
                    <DatePicker x:Name="DueDatePicker" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="DueDateError" Classes="error" />
                    <TextBlock Text="Время выполнения" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TimePicker x:Name="DueTimePicker" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="DueTimeError" Classes="error" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Приоритет" FontWeight="SemiBold" />
                            <ComboBox x:Name="PriorityBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Статус" FontWeight="SemiBold" />
                            <ComboBox x:Name="StateBox" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="surface" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="ТИП ЗАДАЧИ" Classes="section-label" />
                    <ComboBox x:Name="TypeBox" />
                    <StackPanel x:Name="RecurringPanel" Spacing="6" IsVisible="False" Margin="0,5,0,0">
                        <TextBlock Text="Повторять каждые N дней" FontWeight="SemiBold" />
                        <NumericUpDown x:Name="RepeatBox" Minimum="1" Maximum="365" Increment="1" />
                        <TextBlock x:Name="RepeatError" Classes="error" />
                    </StackPanel>
                    <StackPanel x:Name="ProjectPanel" Spacing="6" IsVisible="False" Margin="0,5,0,0">
                        <TextBlock Text="Название проекта" FontWeight="SemiBold" />
                        <TextBox x:Name="ProjectBox" />
                        <TextBlock x:Name="ProjectError" Classes="error" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- Панель кнопок всегда видна, даже если форма длиннее окна -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
            <Button Classes="secondary" Content="Отмена" IsCancel="True" Click="CancelClick" />
            <Button Content="Сохранить задачу" Classes="accent" IsDefault="True" Click="SaveClick" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
