<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskManager.Dialogs.MessageDialog"
        Width="440" MinHeight="200" WindowStartupLocation="CenterOwner"
        CanResize="False" Title="TaskManager"
        Icon="avares://TaskManager/Assets/app-icon.png">
    <StackPanel Margin="26" Spacing="16">
        <TextBlock Text="Сообщение" FontSize="22" FontWeight="SemiBold" />
        <Border Classes="surface" Padding="14">
            <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" />
        </Border>
        <Button Content="Понятно" Classes="accent" HorizontalAlignment="Right" MinWidth="100" Click="CloseClick" />
    </StackPanel>
</Window>
