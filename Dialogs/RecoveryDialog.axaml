<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:TaskManager.Services"
        x:CompileBindings="False"
        x:Class="TaskManager.Dialogs.RecoveryDialog"
        Width="520" MinHeight="240" CanResize="False"
        WindowStartupLocation="CenterOwner" Title="{Binding [dlg.recovery.title], Source={x:Static loc:Loc.Instance}}"
        Icon="avares://TaskManager/Assets/app-icon.png">
    <StackPanel Margin="26" Spacing="16">
        <TextBlock Text="{Binding [dlg.recovery.title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" />
        <Border Classes="surface" Padding="15">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9" Margin="0,4,0,0">
            <Button Classes="secondary" Content="{Binding [dlg.recovery.skip], Source={x:Static loc:Loc.Instance}}" Click="CancelClick" />
            <Button Content="{Binding [dlg.recovery.restore], Source={x:Static loc:Loc.Instance}}" Classes="accent" Click="RestoreClick" />
        </StackPanel>
    </StackPanel>
</Window>
