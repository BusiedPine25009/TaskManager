<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        x:Class="TaskManager.Dialogs.RecoveryDialog"
        Width="520" MinHeight="240" CanResize="False"
        WindowStartupLocation="CenterOwner" Title="Восстановление данных"
        Icon="avares://TaskManager/Assets/app-icon.png">
    <StackPanel Margin="26" Spacing="16">
        <TextBlock Text="Восстановление данных" FontSize="22" FontWeight="SemiBold" />
        <Border Classes="surface" Padding="15">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9" Margin="0,4,0,0">
            <Button Classes="secondary" Content="Не восстанавливать" Click="CancelClick" />
            <Button Content="Восстановить копию" Classes="accent" Click="RestoreClick" />
        </StackPanel>
    </StackPanel>
</Window>
