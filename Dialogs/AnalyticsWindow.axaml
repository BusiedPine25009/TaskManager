<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TaskManager.Dialogs"
        xmlns:vm="using:TaskManager.ViewModels"
        xmlns:loc="using:TaskManager.Services"
        x:CompileBindings="False" x:DataType="local:AnalyticsWindow"
        x:Class="TaskManager.Dialogs.AnalyticsWindow"
        Width="980" Height="720" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterOwner" Title="{Binding [analytics.title], Source={x:Static loc:Loc.Instance}}"
        Icon="avares://TaskManager/Assets/app-icon.png">
    <Grid RowDefinitions="Auto,Auto,*" Margin="26" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [analytics.title], Source={x:Static loc:Loc.Instance}}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding [analytics.subtitle], Source={x:Static loc:Loc.Instance}}" Classes="secondary" />
            </StackPanel>
            <WrapPanel Grid.Column="1" ItemSpacing="7" VerticalAlignment="Center">
                <Button Classes="secondary" Content="{Binding [analytics.period7], Source={x:Static loc:Loc.Instance}}" Click="PeriodSevenClick" />
                <Button Classes="secondary" Content="{Binding [analytics.period30], Source={x:Static loc:Loc.Instance}}" Click="PeriodThirtyClick" />
                <Button Classes="secondary" Content="{Binding [analytics.periodAll], Source={x:Static loc:Loc.Instance}}" Click="PeriodAllClick" />
            </WrapPanel>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Statistics}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Classes="surface" Padding="14" Margin="4">
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Label}" Classes="section-label" /><TextBlock Text="{Binding Value}" FontSize="23" FontWeight="SemiBold" /></StackPanel>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                <Border Classes="surface" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding [analytics.completionChart], Source={x:Static loc:Loc.Instance}}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding [analytics.noCompletionData], Source={x:Static loc:Loc.Instance}}" Classes="secondary" IsVisible="{Binding IsCompletionEmpty}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding HasCompletionData}">
                            <ItemsControl ItemsSource="{Binding CompletionBars}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CompletionBarViewModel">
                                    <StackPanel Width="26" VerticalAlignment="Bottom" Spacing="4"><TextBlock Text="{Binding Count}" FontSize="10" HorizontalAlignment="Center" /><Border Height="{Binding Height}" Background="{DynamicResource AccentBrush}" CornerRadius="4,4,0,0" /><TextBlock Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center" /></StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Classes="surface" Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding [analytics.statusChart], Source={x:Static loc:Loc.Instance}}" FontSize="17" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
                                <!-- Круговая диаграмма: серый диск (виден при отсутствии задач), цветные сектора, отверстие и процент в центре -->
                                <Grid Width="140" Height="140" VerticalAlignment="Top">
                                    <Ellipse Width="130" Height="130" Fill="{DynamicResource HoverBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" />
                                    <ItemsControl ItemsSource="{Binding StatusSegments}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DonutSegmentViewModel"><Path Data="{Binding PathData}" Fill="{Binding Color}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Width="82" Height="82" CornerRadius="41" Background="{DynamicResource SurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DonutCenterText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Легенда: цветная точка, название статуса и количество -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusLegendItems}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LegendItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4">
                                            <Border Width="11" Height="11" CornerRadius="6" Background="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="surface" Padding="18"><StackPanel Spacing="10"><TextBlock Text="{Binding [analytics.priorityChart], Source={x:Static loc:Loc.Instance}}" FontSize="17" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding PriorityBars}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PriorityBarViewModel"><Grid ColumnDefinitions="90,*,Auto" Margin="0,2"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><Border Grid.Column="1" Height="13" Width="{Binding Width}" Background="{Binding Color}" CornerRadius="6" HorizontalAlignment="Left" /><TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
