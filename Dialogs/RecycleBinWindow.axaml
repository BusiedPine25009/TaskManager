<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TaskManager.Dialogs"
        xmlns:vm="using:TaskManager.ViewModels"
        xmlns:loc="using:TaskManager.Services"
        x:CompileBindings="False"
        x:DataType="local:RecycleBinWindow"
        x:Class="TaskManager.Dialogs.RecycleBinWindow"
        Width="820" Height="600" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" Title="{Binding [bin.title], Source={x:Static loc:Loc.Instance}}"
        Icon="avares://TaskManager/Assets/app-icon.png">
    <Grid RowDefinitions="Auto,*" Margin="26">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,0,0,18">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding [bin.title], Source={x:Static loc:Loc.Instance}}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CountText}" Classes="secondary" FontSize="13" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="8" VerticalAlignment="Center">
                <Button Content="{Binding [bin.empty], Source={x:Static loc:Loc.Instance}}" Classes="secondary danger"
                        Click="ClearClick" IsEnabled="{Binding HasEntries}" />
                <Button Content="{Binding [common.close], Source={x:Static loc:Loc.Instance}}" Classes="secondary" Click="CloseClick" />
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeletedTaskViewModel">
                            <Border Classes="surface" Padding="14" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="13">
                                    <Border Background="{Binding PriorityBrush}" CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Spacing="8" MinWidth="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                                   TextWrapping="Wrap" />
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="6">
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="8,4">
                                                <TextBlock Text="{Binding DueDateText}" FontSize="11" />
                                            </Border>
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="8,4">
                                                <TextBlock Text="{Binding PriorityText}" FontSize="11" />
                                            </Border>
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="8,4">
                                                <TextBlock Text="{Binding TypeText}" FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{Binding DeletedAtText}" Classes="secondary"
                                                       FontSize="11" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="6"
                                               VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="{Binding [bin.restore], Source={x:Static loc:Loc.Instance}}" Classes="accent" Tag="{Binding}" Click="RestoreClick" />
                                        <Button Classes="secondary danger" Content="{Binding [bin.deleteForever], Source={x:Static loc:Loc.Instance}}"
                                                Tag="{Binding}" Click="DeleteClick" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Classes="surface" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                    IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [bin.emptyTitle], Source={x:Static loc:Loc.Instance}}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding [bin.emptyHint], Source={x:Static loc:Loc.Instance}}" Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
