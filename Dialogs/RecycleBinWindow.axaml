<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TaskManager.Dialogs"
        xmlns:vm="using:TaskManager.ViewModels"
        x:DataType="local:RecycleBinWindow"
        x:Class="TaskManager.Dialogs.RecycleBinWindow"
        Width="780"
        Height="560"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="Корзина">
    <Grid RowDefinitions="Auto,*" Margin="24">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Spacing="4">
                <TextBlock Text="Корзина" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CountText}" Opacity="0.7"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Очистить корзину" Classes="accent"
                    Click="ClearClick" IsEnabled="{Binding HasEntries}"/>
        </Grid>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeletedTaskViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                    CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="12">
                                    <Border Background="{Binding PriorityBrush}" CornerRadius="3"/>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DueDateText}" Margin="0,0,14,0"/>
                                            <TextBlock Text="{Binding PriorityText}" Margin="0,0,14,0"/>
                                            <TextBlock Text="{Binding TypeText}" Margin="0,0,14,0"/>
                                            <TextBlock Text="{Binding DeletedAtText}" Opacity="0.7"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Восстановить" Tag="{Binding}" Click="RestoreClick"/>
                                        <Button Content="Удалить навсегда" Tag="{Binding}" Click="DeleteClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Корзина пуста" FontSize="20" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}"/>
        </Grid>
    </Grid>
</Window>
